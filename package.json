{
  "name": "webofthings-pi-display-sink",
  "version": "0.1.0",
  "private": true,
  "description": "A Node-WoT control plane for a Raspberry Pi display sink",
  "main": "dist/main.js",
  "scripts": {
    "audit:ci": "npm audit --json | node scripts/verify-audit.cjs",
    "build": "tsc --project tsconfig.json",
    "check:dependencies": "node scripts/verify-dependencies.cjs",
    "lint": "eslint src test",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:integration": "vitest run test/integration",
    "test:unit": "vitest run test/unit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kgmwang1/webofthings.js.git"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "@node-wot/binding-http": "0.9.2",
    "@node-wot/core": "0.9.2"
  },
  "devDependencies": {
    "@types/debug": "4.1.13",
    "@types/node": "22.20.1",
    "eslint": "9.35.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "find-my-way": "9.7.0",
    "uuid": "11.1.1"
  }
}
